		"typescript-eslint": "^8.57.0",
		"vite": "^7.3.1",
		"wrangler": "^4.63.0"
	},
	"dependencies": {
		"@supabase/ssr": "^0.12.5",
		"@supabase/supabase-js": "^2.114.0",
		"drizzle-orm": "^0.45.2",
